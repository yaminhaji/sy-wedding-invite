# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# Never commit .env.local (it is git-ignored).

# Password for the admin page at /admin (required to edit content).
# Use a long, unique password. On Vercel, set it under
# Project -> Settings -> Environment Variables.
ADMIN_PASSWORD=change-me

# Vercel Blob storage (where /admin saves the edited content).
# - On Vercel: connect a PRIVATE Blob store under Project -> Storage and this
#   variable is added for you automatically; nothing to do here.
# - Locally: leave it commented out and edits are saved to .data/invite.json.
#   Only set it here if you want local development to use the real Blob store.
# BLOB_READ_WRITE_TOKEN=
